<Page x:Class="TextAnonymizer.Views.Pages.AnonymizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:views="clr-namespace:TextAnonymizer.Views"
      Title="Anonymisation" Background="Transparent"
      Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <!-- Le NavigationView héberge les pages dans un ScrollViewer : sans cette hauteur, la page prend la taille de
         son contenu et les zones ne défilent jamais. -->
    <Grid Margin="20,8,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Anonymisation" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            <Border Margin="16,0,0,0" Padding="10,2" VerticalAlignment="Center" CornerRadius="10"
                    ToolTip="État de la table de conversion">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#2E7D32" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Table.IsBijectionValid}" Value="False">
                                <Setter Property="Background" Value="#C62828" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Table.IsEmpty}" Value="True">
                                <Setter Property="Background" Value="#6E6E6E" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Foreground="White" Kind="TableLock" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="White"
                               Text="{Binding Table.TableSummary}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ui:InfoBar Grid.Row="1" Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                    Title="Table modifiée"
                    Message="La table a changé depuis la dernière anonymisation : le rétablissement du texte déjà anonymisé peut échouer."
                    IsOpen="{Binding IsTableModifiedWarningVisible}" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button Appearance="Primary" Command="{Binding AnonymizeCommand}" Margin="0,0,8,0"
                           ToolTip="Anonymiser la source (Ctrl+Entrée)">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="ShieldLockOutline" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Anonymiser" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Command="{Binding RestoreCommand}" Margin="0,0,8,0"
                           ToolTip="Rétablir le texte original à partir du résultat (Ctrl+R)">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="UndoVariant" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Rétablir" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Command="{Binding GenerateAutomaticallyCommand}" Margin="0,0,8,0"
                           Visibility="{Binding Table.AutoGenerateEnabled, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="Générer des valeurs fictives pour les entrées sans remplaçant">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="AutoFix" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Générer automatiquement" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Command="{Binding PreviewCommand}" Margin="0,0,8,0"
                           ToolTip="Voir et modifier les remplacements avant de les appliquer">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="EyeOutline" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Aperçu" />
                    </StackPanel>
                </ui:Button>
                <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" VerticalAlignment="Center"
                                 ToolTip="Génération en cours…"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:SourceView Grid.Column="0" />
                <views:ResultView Grid.Column="2" />
            </Grid>
        </Grid>
    </Grid>
</Page>
