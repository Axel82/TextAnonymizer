<UserControl x:Class="TextAnonymizer.Views.PreviewDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             MinWidth="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None" MaxHeight="360">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Retenu" Width="70"
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Original" Width="2*" IsReadOnly="True" Binding="{Binding Original}" />
                <DataGridTemplateColumn Header="Type" Width="90" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{Binding EntityType, Converter={StaticResource EntityTypeToBrush}}">
                                <TextBlock Text="{Binding EntityType}" Foreground="Black" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Remplaçant (modifiable)" Width="2*"
                                    Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Occ." Width="60" IsReadOnly="True" Binding="{Binding Occurrences}" />
            </DataGrid.Columns>
        </DataGrid>

        <ui:InfoBar Grid.Row="2" Severity="Error" IsClosable="False" IsOpen="True" Title="Validation impossible"
                    Message="{Binding ErrorMessage}" Margin="0,10,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Appearance="Primary" Command="{Binding AcceptAllCommand}" Margin="0,0,8,0"
                       ToolTip="Appliquer tous les remplacements de la liste">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="CheckAll" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Tout valider" />
                </StackPanel>
            </ui:Button>
            <ui:Button Command="{Binding AcceptSelectionCommand}" Margin="0,0,8,0"
                       ToolTip="N'appliquer que les lignes cochées dans la colonne « Retenu »">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="CheckboxMarkedOutline" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Valider la sélection" />
                </StackPanel>
            </ui:Button>
            <ui:Button Command="{Binding RejectCommand}" ToolTip="Fermer sans rien modifier">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="CloseCircleOutline" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Annuler" />
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>
