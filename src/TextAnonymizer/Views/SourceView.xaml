<UserControl
    x:Class="TextAnonymizer.Views.SourceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:behaviors="clr-namespace:TextAnonymizer.Views.Behaviors"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border Style="{StaticResource ZoneCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <icons:PackIconMaterial
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Kind="TextBoxOutline" />
                    <TextBlock Style="{StaticResource ZoneHeader}" Text="Source" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding PasteSourceCommand}"
                        ToolTip="Coller le texte du presse-papiers (texte brut)">
                        <icons:PackIconMaterial Kind="ContentPaste" />
                    </ui:Button>
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding CopySourceCommand}"
                        ToolTip="Copier la source (texte brut)">
                        <icons:PackIconMaterial Kind="ContentCopy" />
                    </ui:Button>
                    <ui:Button
                        Appearance="Transparent"
                        Command="{Binding ClearSourceCommand}"
                        ToolTip="Vider la source">
                        <icons:PackIconMaterial Kind="EraserVariant" />
                    </ui:Button>
                </StackPanel>
            </DockPanel>

            <avalon:TextEditor
                Grid.Row="1"
                behaviors:AvalonEditBehavior.Text="{Binding SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                HorizontalScrollBarVisibility="Auto"
                Style="{StaticResource TextZoneEditor}"
                VerticalScrollBarVisibility="Auto"
                WordWrap="False" />
        </Grid>
    </Border>
</UserControl>
