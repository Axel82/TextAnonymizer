<ui:FluentWindow
    x:Class="TextAnonymizer.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:pages="clr-namespace:TextAnonymizer.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TextAnonymizer"
    Icon="pack://application:,,,/Icon/app.ico"
    Width="1280"
    Height="780"
    MinWidth="960"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Command="{Binding Table.LoadCommand}" Gesture="Ctrl+O" />
        <KeyBinding Command="{Binding Table.SaveCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding AnonymizeCommand}" Gesture="Ctrl+Enter" />
        <KeyBinding Command="{Binding RestoreCommand}" Gesture="Ctrl+R" />
        <KeyBinding Command="{Binding CopyResultCommand}" Gesture="Ctrl+D" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="TextAnonymizer" Grid.Row="0" />

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Anonymisation"
                    TargetPageType="{x:Type pages:AnonymizationPage}"
                    ToolTip="Source, résultat et actions d'anonymisation">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ShieldLock24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="Table de conversion"
                    TargetPageType="{x:Type pages:TablePage}"
                    ToolTip="Entrées, validation, import et export">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="TableEdit24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    AutomationProperties.Name="Moteur de rendu"
                    Content="Moteur de rendu"
                    TargetPageType="{x:Type pages:ViewerPage}"
                    ToolTip="Visualiser du JSON, Markdown, HTML ou PHP">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentText24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    AutomationProperties.Name="Comparateur de fichiers"
                    Content="Comparateur de fichiers"
                    TargetPageType="{x:Type pages:ComparePage}"
                    ToolTip="Comparer deux fichiers ou deux textes">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BranchCompare24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Paramètres"
                    TargetPageType="{x:Type pages:SettingsPage}"
                    ToolTip="Stratégie, génération automatique, thème">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Grid.Row="1"
            Margin="0,0,0,16"
            VerticalAlignment="Bottom" />
        <ui:ContentDialogHost
            x:Name="DialogHost"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
